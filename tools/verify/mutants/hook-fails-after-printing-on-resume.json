{
  "id": "hook-fails-after-printing-on-resume",
  "description": "The hook prints the mandate and then exits 1 when the source is resume: the mandate arrives and the hook still reports failure on resume only.",
  "edits": [
    {
      "op": "replace",
      "path": "plugins/pstack/hooks/session-start.sh",
      "find": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-context.md\"",
      "with": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-context.md\"\ncase $(cat) in *'\"source\"'*'\"resume\"'*) exit 1 ;; esac"
    }
  ],
  "catches": {
    "check": "S4",
    "assertion": "resume-outcome"
  }
}
